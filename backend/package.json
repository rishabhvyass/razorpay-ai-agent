    "uuid": "13.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
