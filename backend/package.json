{
  "name": "checkout-concierge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Checkout Concierge - agentic commerce backend foundation (Express + Supabase Postgres).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:logic && npm run test:http && npm run test:http:prod",
    "test:logic": "node scripts/smoke-logic.mjs",
    "test:http": "node scripts/smoke-http.mjs",
    "test:http:prod": "node scripts/smoke-http.mjs --prod",
    "test:schema": "node scripts/verify-schema-pglite.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "survey:live": "node scripts/survey-live.mjs",
    "db:sql": "node scripts/print-setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "uuid": "13.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
