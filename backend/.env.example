# ---------------------------------------------------------------------------
# Supabase
#
# Project URL and keys: Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Safe to ship to clients. Subject to Row Level Security.
SUPABASE_ANON_KEY=

# BACKEND ONLY. Bypasses Row Level Security entirely.
# Never expose this to React Native, Next.js, or any browser bundle.
# Never commit the real value - keep it in .env, which is gitignored.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Razorpay (payments)
#
# Razorpay Dashboard -> Settings -> API Keys, with the dashboard in TEST MODE.
# The webhook secret is NOT issued by Razorpay: you invent a string and enter the
# same one under Settings -> Webhooks when you create the webhook.
#
# ALL THREE OR NONE. The server refuses to boot with a partial set, because a key
# id without a webhook secret is the one genuinely dangerous state - it can take
# money and then has no way to verify that the payment happened.
#
# Leaving all three blank is fine and fully supported: the server boots, the
# catalogue and order routes behave normally, and the three payment routes answer
# 501 PAYMENT_NOT_CONFIGURED.
#
# RAZORPAY_KEY_ID must start with rzp_test_ whenever NODE_ENV is not production.
# That check exists so a live key cannot be pointed at a development database by
# accident and start charging real cards.
#
# BACKEND ONLY: the secret and the webhook secret must never reach a browser
# bundle. Do not copy them into a VITE_ variable - anything prefixed VITE_ is
# compiled into the frontend and served to every visitor.
# ---------------------------------------------------------------------------

# e.g. rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_ID=

# BACKEND ONLY.
RAZORPAY_KEY_SECRET=

# BACKEND ONLY. A string you choose; must match the webhook config in the
# dashboard exactly, or every delivery will fail signature verification.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Agent (OpenAI, Claude / Anthropic, OpenRouter, or xAI)
#
# The API key for the AI provider used by POST /api/chat. The direct OpenAI
# integration is the recommended local setup. Get a key from
# https://platform.openai.com/api-keys
#
# Without this key the server boots normally and every other route works;
# POST /api/chat answers 501 NOT_IMPLEMENTED until one provider key is set.
#
# BACKEND ONLY: a model credential in a browser bundle is a billable resource
# anyone can spend. Do not copy this into a VITE_ variable.
# ---------------------------------------------------------------------------

# Direct OpenAI API key (starts with sk-). Keep this in backend/.env only.
OPENAI_API_KEY=

# Direct OpenAI model. The default is gpt-5-mini; set this if your project uses
# a different model or an OpenAI-compatible gateway.
# OPENAI_MODEL=gpt-5-mini

# Alternative provider keys. Use these only if you are not using OpenAI directly.
# Your Anthropic/OpenRouter/AgentRouter API key.
AGENTROUTER_API_KEY=
OPENROUTER_API_KEY=

# Which Claude/OpenRouter model to use when an alternative provider key is set.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# xAI alternative.
# XAI_API_KEY=
# GROK_MODEL=grok-4.6
