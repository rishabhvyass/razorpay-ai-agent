# ---------------------------------------------------------------------------
# Secrets. Never commit these.
#
# backend/.env holds SUPABASE_SERVICE_ROLE_KEY, which bypasses row-level
# security entirely. The .env.example files are committed instead - they list
# every variable with placeholder values, so a fresh clone knows what to set.
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
**/build/
*.tsbuildinfo

# React Native iOS / Android build artifacts
**/Pods/
**/*.xcworkspace/xcuserdata
**/*.xcuserdatad
**/*.xcuserstate
**/android/app/build/
**/.gradle/
**/android/build/

# Claude Code / agent-skills local state
.claude/settings.local.json
.claude/skills/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Generated setup SQL
supabase/setup.generated.sql

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.swp

.scratch/
