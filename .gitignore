# ---------------------------------------------------------------------------
# Secrets. Never commit these.
#
# backend/.env holds SUPABASE_SERVICE_ROLE_KEY, which bypasses row-level
# security entirely. The .env.example files are committed instead - they list
# every variable with placeholder values, so a fresh clone knows what to set.
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Claude Code / agent-skills local state
#
# settings.local.json is per-machine permissions. .claude/skills/ holds absolute
# symlinks into this machine's filesystem, so committing them would produce
# broken links on any other device - recreate them with:
#   npx skills add supabase/agent-skills
.claude/settings.local.json
.claude/skills/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Generated setup SQL. Derived from migrations/ + seed.sql by `npm run db:sql`,
# so committing it would mean two copies of the schema that can drift apart.
supabase/setup.generated.sql

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.swp

# Throwaway working directory. Anything an agent or a script writes here is
# probe output, one-off notes, or a scratch response body from an API it was
# testing - none of it belongs in history, and some of it may echo a request
# that carried a credential.
.scratch/
