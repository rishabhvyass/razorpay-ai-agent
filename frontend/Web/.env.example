# ---------------------------------------------------------------------------
# Checkout Concierge - web frontend
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here: no AGENTROUTER_API_KEY, ANTHROPIC_API_KEY, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, or SUPABASE_SERVICE_ROLE_KEY. Those belong to the
# backend only, and anything in this file is readable by anyone who opens
# devtools.
# ---------------------------------------------------------------------------

# Backend base URL.
# Leave EMPTY in development: vite.config.ts proxies /api and /health to
# localhost:3000, which keeps the browser same-origin and avoids CORS entirely.
# Set an absolute origin (https://api.example.com) only for a deployed build.
VITE_API_URL=

# Development fallback for the one backend route that does not exist yet.
#
# POST /api/chat is genuinely unbuilt, so with this on the chat turn is served by
# src/services/mock/ and every mocked surface renders a visible
# "MOCK - awaiting backend" marker so no reviewer mistakes it for real data.
#
# The payment routes are NOT in that category any more. Razorpay order creation,
# payment links, Standard Checkout and webhook verification are all built and
# real. The flag still covers the payment-LINK states so the flow stays walkable
# with no Razorpay keys configured, and so the failure state is reachable on
# demand - that is a labelled simulation, not a claim about a payment.
#
# Standard Checkout has no mock branch and refuses to run under this flag. It
# means Razorpay's own modal collecting real card details, and a local stand-in
# for that would be a fake payment screen. Set this to false to use it.
#
# Products, orders, conversations and activity always hit the live backend
# regardless of this flag. There is no mock catalogue.
VITE_USE_MOCK=true

# Razorpay's PUBLISHABLE key id, e.g. rzp_test_XXXXXXXXXXXXXX. OPTIONAL.
#
# This is the only Razorpay value that may ever appear in this file, and it is
# safe here by design: it is the half Razorpay intends to sit in a browser, it
# appears in every checkout integration, and on its own it can create nothing.
#
# Its partner RAZORPAY_KEY_SECRET signs orders, payments and webhooks. It belongs
# to backend/.env and must never be given a VITE_ name - anything prefixed VITE_
# is inlined into the JavaScript bundle and served to every visitor.
#
# Optional because the app does not need it: POST /api/create-order returns the
# key that created the Razorpay order, and that is the key the modal is opened
# with, so the two can never come from different accounts. Set this only if you
# want lib/config.ts to cross-check it and report a mismatch as a configuration
# error instead of letting it fail inside Razorpay's modal.
VITE_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# Dev server only. NOT VITE_-prefixed, so it never reaches the bundle.
# ---------------------------------------------------------------------------

# Where vite.config.ts proxies /api and /health during `npm run dev`.
# Only needed if you changed PORT in backend/.env - this file cannot see that
# one, so without this the proxy keeps pointing at the old port and every
# request quietly returns nothing.
# Default: http://localhost:3000
# API_PROXY_TARGET=http://localhost:3000


